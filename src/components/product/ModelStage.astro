---
/**
 * ModelStage — the one shared 3D component (hero + product page). Wraps <model-viewer> (3.4.0, dynamic import()).
 * Contract (plan 2.1): the photo ALWAYS renders underneath first (LCP + fallback); the model fades in after `load`.
 * Branded loading state after 400 ms; failure (error / 15 s timeout / missing file) -> photo, silently, plus a bubbling
 * 'stage:failed' event. AR pill hidden until load. Desktop: "Lihat di HP-mu" + QR popover. One viewer per stage.
 * Props:
 *   slug, name       product identity (id + QR label)
 *   photo?           ImageMetadata (poster + fallback). Never upscaled past its natural size.
 *   glb?, usdz?      full URLs from R2()/R2Model(). No glb = static photo only (no JS).
 *   alt              Bahasa alt text
 *   autoRotate       default false
 *   loading          'eager' (hero: starts after first paint) | 'lazy' (starts when visible or activated)
 *   pageUrl          canonical product URL (used for the phone QR)
 *   timeoutMs?       override the 15 s timeout (dev fixtures)
 *   maxWidth?        max rendered photo width in px (default 960)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArButton from '../ui/ArButton.astro';
import Wordmark from '../layout/Wordmark.astro';
import QrCode from './QrCode.astro';

interface Props {
  slug: string; name: string; photo?: ImageMetadata; glb?: string; usdz?: string; alt: string;
  autoRotate?: boolean; loading?: 'eager' | 'lazy'; pageUrl: string; timeoutMs?: number; maxWidth?: number; idSuffix?: string;
}
const { slug, name, photo, glb, usdz, alt, autoRotate = false, loading = 'lazy', pageUrl, timeoutMs, maxWidth = 960, idSuffix = '' } = Astro.props;
const w = photo ? Math.min(photo.width, maxWidth) : 0;
const h = photo ? Math.round((photo.height * w) / photo.width) : 0;
const popId = `qr-pop-${slug}${idSuffix}`;
---
<div class="stage" data-stage data-state={glb ? 'idle' : 'photo'} data-glb={glb} data-usdz={usdz} data-alt={alt}
  data-loading-mode={loading} data-autorotate={String(autoRotate)} data-timeout-ms={timeoutMs}>
  {photo
    ? <Image class="stage__photo" src={photo} width={w} height={h} alt={alt} loading={loading} fetchpriority={loading === 'eager' ? 'high' : 'auto'} decoding="async" />
    : <div class="stage__empty"><span>Foto produk segera hadir</span></div>}

  {glb && (
    <>
      <div class="stage__viewer-host" data-viewer-host></div>

      <div class="stage__loading" aria-hidden="true">
        <Wordmark height={40} />
        <div class="stage__bar"><i data-progress></i></div>
        <p>Menyiapkan pratinjau 3D…</p>
      </div>

      <p class="stage__hint" data-hint hidden>Geser untuk memutar</p>
      <div class="stage__launch" data-launch hidden><p>Membuka kamera…</p></div>

      <div class="stage__actions">
        <ArButton data-ar state="hidden">Lihat di ruanganmu</ArButton>
        <ArButton data-qr-trigger state="hidden" icon="cube" popovertarget={popId} aria-label="Lihat di HP-mu: tampilkan kode QR">Lihat di HP-mu</ArButton>
      </div>

      <div class="stage__pop" id={popId} popover>
        <QrCode url={pageUrl} label={`Kode QR untuk membuka ${name}`} size={176} />
        <p>Pindai dengan kamera HP untuk melihat produk ini di ruanganmu.</p>
      </div>

      <p class="visually-hidden" role="status" aria-live="polite" data-status></p>
    </>
  )}
</div>

<style>
  .stage { position: relative; width: 100%; height: 100%; min-height: 0; }
  .stage__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: var(--space-6);
    transition: opacity var(--dur) var(--ease); }
  .stage[data-state='ready'] .stage__photo { opacity: 0; }
  .stage__empty { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ink-700); font-weight: var(--weight-bold); }

  .stage__viewer-host { position: absolute; inset: 0; }
  .stage :global(.stage__viewer) { width: 100%; height: 100%; background: transparent; --poster-color: transparent;
    opacity: 0; transition: opacity var(--dur) var(--ease); }
  .stage[data-state='ready'] :global(.stage__viewer) { opacity: 1; }

  .stage__loading { position: absolute; inset: 0; display: none; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-4);
    background: var(--surface-sunken); color: var(--ink-700); text-align: center; padding: var(--space-6); }
  .stage.is-loading-visible .stage__loading { display: flex; }
  .stage__loading p { font-size: var(--text-14); font-weight: var(--weight-bold); }
  .stage__bar { width: min(240px, 70%); height: var(--space-2); background: var(--surface); border: 1px solid var(--border-control); border-radius: var(--radius-pill); overflow: hidden; }
  .stage__bar i { display: block; height: 100%; width: 0; background: var(--brand-700); transition: width var(--dur) var(--ease); }

  .stage__hint { position: absolute; left: 50%; bottom: var(--space-4); transform: translateX(-50%); margin: 0; pointer-events: none;
    padding: var(--space-2) var(--space-4); background: var(--surface); color: var(--ink-900); border: 1px solid var(--border-soft);
    border-radius: var(--radius-pill); font-size: var(--text-14); font-weight: var(--weight-bold); white-space: nowrap; }
  .stage__hint[hidden] { display: none; }

  .stage__actions { position: absolute; right: var(--space-4); top: var(--space-4); display: flex; gap: var(--space-2); }
  .stage__launch { position: absolute; inset: 0; display: grid; place-items: center; background: var(--scrim); }
  .stage__launch[hidden] { display: none; }
  .stage__launch p { padding: var(--space-3) var(--space-6); background: var(--surface); border-radius: var(--radius-pill); font-weight: var(--weight-bold); }

  .stage__pop { margin: auto; padding: var(--space-6); max-width: min(320px, calc(100vw - 2 * var(--gutter)));
    background: var(--surface); color: var(--ink-900); border: 1px solid var(--border-control); border-radius: var(--radius-lg); box-shadow: var(--shadow-raised);
    text-align: center; }
  .stage__pop:popover-open { display: grid; gap: var(--space-4); justify-items: center; }
  .stage__pop::backdrop { background: var(--scrim); }
  .stage__pop p { font-size: var(--text-14); }
</style>

<script>
  import { initStages } from '../../lib/stage';
  initStages();
</script>

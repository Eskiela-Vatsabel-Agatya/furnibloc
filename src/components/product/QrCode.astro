---
/**
 * QrCode — build-time inline SVG QR (the `qrcode` package; no runtime generation, no third-party API).
 * Content is ALWAYS the absolute canonical URL passed in. Pure black on pure white, error correction Q, 4-module quiet zone.
 * Sits on a FLAT white tile: never inside a neumorphic inset, never copper-tinted (scan reliability beats style).
 * Props: url (required), label (aria-label), size (px, default 176), class?
 */
import { qrSvg } from '../../lib/qr';
interface Props { url: string; label: string; size?: number; class?: string }
const { url, label, size = 176, class: cls } = Astro.props;
const svg = await qrSvg(url, { label, size });
---
<div class:list={['qr', cls]} set:html={svg} />

<style>
  .qr { display: inline-block; line-height: 0; background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--radius-sm); }
  .qr :global(svg) { display: block; max-width: 100%; height: auto; }
</style>

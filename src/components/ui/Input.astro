---
/**
 * Input — inset field, 1px control border, visible focus ring.
 * Props: id (required), name?, label (required), type ('text'), value?, placeholder?, hint?, error?, warning?,
 *        disabled?, required?, icon? (leading Icon name, e.g. 'search'), class?
 * States: default, hover, focus, error (red border + inline message), warning (amber border + inline message), disabled.
 * Error beats warning. Messages are tied to the field with aria-describedby; errors are announced (role=alert).
 */
import Icon from './Icon.astro';
interface Props {
  id: string; label: string; name?: string; type?: 'text' | 'search' | 'email' | 'tel' | 'url' | 'number' | 'password'; value?: string; placeholder?: string;
  hint?: string; error?: string; warning?: string; disabled?: boolean; required?: boolean; icon?: string; class?: string; [k: string]: unknown;
}
const { id, label, name, type = 'text', value, placeholder, hint, error, warning, disabled = false, required = false, icon, class: cls, ...rest } = Astro.props;
const msg = error ?? warning ?? hint;
const state = error ? 'error' : warning ? 'warning' : 'default';
const msgId = msg ? `${id}-msg` : undefined;
---
<div class:list={['field', `field--${state}`, cls]}>
  <label class="field__label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <div class="field__control">
    {icon && <Icon name={icon} size={20} class="field__icon" />}
    <input
      class:list={['field__input', icon && 'has-icon']}
      id={id} name={name ?? id} type={type} value={value} placeholder={placeholder}
      disabled={disabled} required={required}
      aria-invalid={error ? 'true' : undefined} aria-describedby={msgId}
      {...rest}
    />
  </div>
  {msg && <p class="field__msg" id={msgId} role={error ? 'alert' : undefined}>{msg}</p>}
</div>

<style>
  .field { display: grid; gap: var(--space-2); }
  .field__label { font-weight: var(--weight-bold); font-size: var(--text-14); color: var(--ink-900); }
  .field__control { position: relative; display: flex; align-items: center; }
  .field__control :global(.field__icon) { position: absolute; left: var(--space-4); color: var(--ink-700); pointer-events: none; }
  .field__input {
    width: 100%; min-height: 48px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-sunken); color: var(--ink-900);
    border: 1px solid var(--border-control); border-radius: var(--radius);
    box-shadow: var(--shadow-inset);
    font-family: var(--font); font-size: var(--text-16); line-height: var(--space-6);
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }
  .field__input.has-icon { padding-left: var(--space-12); }
  .field__input::placeholder { color: var(--ink-700); opacity: 1; }
  .field__input:hover { background: var(--surface); }
  .field__input:focus { outline: 2px solid var(--brand-600); outline-offset: 2px; border-color: var(--brand-600); background: var(--surface); }
  .field__input:disabled { opacity: .5; cursor: not-allowed; box-shadow: none; background: var(--surface); }
  .field--error .field__input { border-color: var(--danger); }
  .field--warning .field__input { border-color: var(--warning-ink); }
  .field__msg { font-size: var(--text-14); line-height: var(--leading-ui); color: var(--ink-700); }
  .field--error .field__msg { color: var(--danger-ink); }
  .field--warning .field__msg { color: var(--warning-ink); }
</style>

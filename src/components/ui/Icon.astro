 *   label  accessible name. Omit for decorative icons (aria-hidden).
 * Stroke icons use currentColor. `whatsapp` is a filled glyph (Simple Icons, CC0).
 */
interface Props { name: string; size?: number; label?: string; class?: string }
const { name, size = 24, label, class: cls } = Astro.props;

const stroke: Record<string, string[]> = {

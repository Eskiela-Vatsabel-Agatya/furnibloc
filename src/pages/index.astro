---
// Phase 1 placeholder: proves the shell and the deploy pipeline. Phase 2 replaces this with Hero + Catalog.
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site';
---
<BaseLayout
  title="FurniBLOC — Showroom Furnitur & Dekorasi di Solo"
  description="Showroom kolektif furnitur, dekorasi, dan kerajinan kualitas ekspor dari 30 tenant IKM Soloraya di Sriwedari, Surakarta."
  canonicalPath="/"
>
  <section class="container soon">
    <h1>FurniBLOC</h1>
    <p>Segera hadir: katalog 3D &amp; AR FurniBLOC</p>
    <p class="soon__sub">{site.tagline}</p>
  </section>
</BaseLayout>

<style>
  .soon { display: grid; gap: var(--space-4); padding-block: var(--space-16); }
  .soon__sub { color: var(--ink-700); }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { waLink } from '../lib/whatsapp';
---
<BaseLayout title="Halaman tidak ditemukan — FurniBLOC" description="Halaman yang Anda cari tidak ditemukan." canonicalPath="/404" noindex>
  <section class="container nf">
    <h1>Halaman tidak ditemukan</h1>
    <p>Tautan ini mungkin sudah berubah. Lihat koleksi kami, atau tanyakan langsung lewat WhatsApp.</p>
    <div class="cta">
      <Button href="/#katalog">Lihat katalog</Button>
      <Button variant="whatsapp" href={waLink({ topic: 'halaman yang tidak ditemukan' })} target="_blank" rel="noopener">Tanya lewat WhatsApp</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { display: grid; gap: var(--space-4); padding-block: var(--space-16); justify-items: start; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
